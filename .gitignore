# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Backend (server/) et Cloud Functions (functions/) : dépendances et secrets
server/node_modules/
server/.env
functions/node_modules/
functions/.env
functions/.runtimeconfig.json

# Logs de crash du démon Gradle (générés localement, jamais à committer)
hs_err_pid*.log
replay_pid*.log

# Config Firebase native : à générer localement via `flutterfire configure`
# ou téléchargée depuis la console Firebase (contient des identifiants liés
# au projet, pas de secret sensible en soi, mais spécifique à chaque
# environnement).
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist

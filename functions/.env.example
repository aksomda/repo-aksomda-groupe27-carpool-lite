# Copiez ce fichier en ".env" dans le dossier functions/ (chargé
# automatiquement par Cloud Functions 2ème génération, jamais commité).

# URL publique de votre API de synchronisation (server/), SANS le / final.
# Une Cloud Function tourne sur les serveurs de Google : "localhost" ne
# fonctionnera pas, il faut une adresse joignable depuis Internet
# (hébergement du dossier server/ sur une VM, Render, Railway, Cloud Run...).
SYNC_API_BASE_URL=https://votre-api-sync.exemple.com/api/sync

# Doit être identique à SYNC_API_KEY dans server/.env
SYNC_API_KEY=changez-cette-cle-secrete

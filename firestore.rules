rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ⚠️ L'application ne possède pas encore d'authentification (voir
    // DEPANNAGE_FIRESTORE.md). Ces règles autorisent donc explicitement
    // la lecture/écriture publique, pour remplacer les règles "mode test"
    // par défaut de la console (qui, elles, EXPIRENT au bout de 30 jours
    // et provoquent exactement le type de blocage rencontré ici).
    //
    // À restreindre avant une vraie mise en production, par exemple :
    //   allow read, write: if request.auth != null;
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

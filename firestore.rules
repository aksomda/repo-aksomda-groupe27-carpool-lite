rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authentification maintenant câblée (Firebase Auth + AuthProvider) :
    // ces règles remplacent le mode "tout ouvert" par un contrôle minimal
    // par utilisateur connecté. À affiner selon les besoins métier réels
    // avant mise en production (ex. lecture publique de "universities").

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /universities/{docId} {
      allow read: if true; // besoin de sélection avant inscription/connexion
      allow write: if request.auth != null;
    }

    // ⚠️ Un utilisateur authentifié peut lire SON PROPRE code ici, ce qui
    // affaiblit la garantie "preuve de possession de la boîte mail" (il n'a
    // pas besoin de consulter son email pour connaître le code). Pour une
    // vérification réellement sûre, migrer la comparaison du code vers une
    // Cloud Function (Admin SDK, qui ignore ces règles) plutôt qu'une
    // lecture cliente comme actuellement implémenté dans
    // AuthRemoteDataSource.verifyEmailOtp.
    match /otp_codes/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Écriture réservée à l'app (création de la demande d'email) ; la
    // lecture/traitement réel est fait côté extension Firebase "Trigger
    // Email" avec les droits admin, donc pas besoin d'autoriser la lecture
    // ici.
    match /mail/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
